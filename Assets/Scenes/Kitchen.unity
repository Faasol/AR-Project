  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2067693474}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c2fa22d0d2ad6e499e1b151b1ce6fa1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MultiImageAugmenter
  stepCardPrefab: {fileID: 6492759425783617552, guid: fce45acf54367c643938bf9edb14276e, type: 3}
  cardScale: 2
  shiftLeftAmount: 0.5
  floatOutFromWall: 0.2
  verticalOffset: 0
  recipeSteps:
  - targetImageName: pesto-image
    stepTitle: 1. Gather Your Ingredients
    stepDescription: 'Check your workspace to ensure you have all the required components:
      1 clove of garlic, 2-3 grams of coarse salt, 50 grams of Genovese basil, 15
      grams of pine nuts, 30 grams of Parmigiano, 10 grams of Pecorino and 50 ml
      of extra virgin olive oil. Check them all off to proceed! Once completed, look
      at the garlic marker to begin prepping.'
    timerSeconds: 0
    videoFile: {fileID: 0}
  - targetImageName: garlic-bulb
    stepTitle: 2. Prep the Garlic
    stepDescription: 'Take 1 fresh clove of garlic and peel it completely. Use your
      knife to slice it into thin layers, then place the sliced pieces directly into
      the bottom of your marble mortar. When you are done slicing, proceed to the
      salt step to prepare your grinding base.

'
    timerSeconds: 0
    videoFile: {fileID: 32900000, guid: e990793783b1191438e83363067d8ad1, type: 3}
  - targetImageName: tablesaltshaker
    stepTitle: 3. Add Coarse Salt
    stepDescription: 'Take 1 pinch of coarse sea salt (about 2-3 grams) and throw
      it directly into the mortar over your garlic slices. The heavy salt crystals
      are crucial because they act as a natural abrasive to help grind down the garlic
      fibers. Next, focus your attention on the mortar marker to begin grinding.

'
    timerSeconds: 0
    videoFile: {fileID: 0}
  - targetImageName: mortar-pestle
    stepTitle: 4. Grind the Base
    stepDescription: 'Take your wooden pestle and begin crushing the garlic and salt
      together. Use a firm, rotating circular motion against the marble walls of
      the mortar until the mixture breaks down completely into a smooth, uniform
      white paste. Once the paste is perfectly smooth, scan the basil marker to prepare
      your leaves.

'
    timerSeconds: 0
    videoFile: {fileID: 32900000, guid: eaaa18a23452037498989a595c367d34, type: 3}
  - targetImageName: basil-plant
    stepTitle: 5. Prepare the Basil
    stepDescription: 'Take 50 grams of fresh Genovese basil leaves. Wash them very
      gently in cold water, then blot them completely dry with a paper towel. Ensure
      they are dry and completely unbruised before adding them to the mortar. After
      drying the leaves, head to the pine nuts step to start blending.

'
    timerSeconds: 0
    videoFile: {fileID: 32900000, guid: 59f8b4c011884cb45a7c8ac3d9e4ce73, type: 3}
  - targetImageName: pinenuts
    stepTitle: 6. Blend the Pine Nuts
    stepDescription: 'Take 15 grams of high-quality pine nuts and drop them directly
      into the mortar with your basil and garlic paste. Use the pestle to smash them
      down, rotating firmly until the mixture takes on a rich, thick, and creamy
      texture. When the nuts are fully creamed, move over to the cheese marker to
      enrich the sauce.

'
    timerSeconds: 0
    videoFile: {fileID: 0}
  - targetImageName: cheese
    stepTitle: 7. Incorporate the Cheese
    stepDescription: 'Take 30 grams of finely grated Parmigiano Reggiano and 10 grams
      of grated Fiore Sardo (Pecorino). Pour both cheeses into the mortar and use
      the pestle to gently fold and blend them completely into the green cream base.
      Once the cheeses are fully incorporated, advance to the oil marker to begin
      the final emulsion.

'
    timerSeconds: 0
    videoFile: {fileID: 0}
  - targetImageName: vegetable-oil
    stepTitle: 8. Emulsify with Olive Oil
    stepDescription: 'Take 50 ml of extra virgin olive oil and pour it into the mortar
      in a slow, steady stream. Use a gentle, circular motion with the pestle to
      blend the oil until the mixture becomes a brilliant, uniform green sauce. With
      your sauce fully emulsified, head over to the cooking pot marker to prepare
      your pasta.

'
    timerSeconds: 0
    videoFile: {fileID: 32900000, guid: 43f191e862b41394f89b28409470fb77, type: 3}
  - targetImageName: cooking-pot
    stepTitle: 9. Prepare the Pasta Pot
    stepDescription: 'Take a large pot filled with water, bring it to a rolling boil,
      add a handful of salt, and drop in your pasta. Never heat your pesto on the
      stove! Instead, take a single spoonful of hot pasta water to dilute the pesto
      in your serving bowl before mixing. While the pasta finishes cooking, move
      to the final plate marker for assembly.

'
    timerSeconds: 660
    videoFile: {fileID: 0}
  - targetImageName: pesto-sauce
    stepTitle: 10. Mix and Enjoy!
    stepDescription: 'Take your cooked, drained pasta and toss it directly into the
      serving bowl with your fresh, hand-crafted pesto. Mix thoroughly until every
      noodle is completely coated, garnish with a few extra pine nuts, and serve
      immediately! Buon appetito!

'
    timerSeconds: 0
    videoFile: {fileID: 0}
